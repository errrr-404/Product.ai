{
	"name": "bitmavenn/bulk-list-import",
	"description": "Turn a raw pasted product list into reviewable draft WooCommerce products with continuous SKUs.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.0"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"test": [
			"@test:parser",
			"@test:validator",
			"@test:policy",
			"@test:prompts",
			"@test:gate"
		],
		"test:parser": "php bulk-list-import/tests/test-parser-fixtures.php",
		"test:validator": "php bulk-list-import/tests/test-response-validator.php",
		"test:policy": "php bulk-list-import/tests/test-retry-policy.php",
		"test:prompts": "php bulk-list-import/tests/test-prompt-builder.php",
		"test:gate": "php bulk-list-import/tests/test-gate-policy.php"
	}
}
