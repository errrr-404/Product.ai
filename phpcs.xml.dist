<?xml version="1.0"?>
<ruleset name="Bulk List Import">
	<description>WordPress Coding Standards for Bulk List Import.</description>

	<file>bulk-list-import</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!--
		Minimum supported versions. The WordPress figure is largely decorative —
		WooCommerce is a hard dependency and its own minimum is higher — but it has
		to match the plugin header and README.
	-->
	<config name="minimum_wp_version" value="6.2"/>
	<config name="testVersion" value="8.0-"/>

	<rule ref="WordPress"/>

	<!--
		PHPCompatibilityWP catches removed and deprecated functions, but be clear
		about what it does NOT cover: the latest stable php-compatibility is 9.3.5,
		which predates PHP 8 entirely. It knows nothing about functions added in
		8.0 or later, so it will NOT flag an 8.1+ call in a codebase declaring 8.0
		support. Verified by probe, not assumed.

		The real check is running tests/ under PHP 8.0. Treat a green run here as
		evidence about deprecations only.
	-->
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="bulk-list-import"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="bli_"/>
				<element value="BLI_"/>
				<element value="BulkListImport"/>
			</property>
		</properties>
		<!--
			The fixture runner is a standalone CLI script executed as
			`php tests/test-parser-fixtures.php`. It is never loaded into WordPress,
			so its file-scope variables cannot collide with anything.
		-->
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!--
		manage_woocommerce is defined by WooCommerce, not core, so the sniff cannot
		know it. Declaring it here keeps the sniff active for genuine typos.
	-->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="manage_woocommerce"/>
			</property>
		</properties>
	</rule>

	<!--
		The fixture runner writes diagnostics to a terminal, not to a browser. Its
		printf/var_export output is the entire point of the script; escaping it for
		HTML would corrupt the report.
	-->
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.PHP.DevelopmentFunctions">
		<exclude-pattern>*/tests/*</exclude-pattern>
	</rule>

	<!--
		Exception messages in the AI layer are developer-facing diagnostics, and the
		classes that raise them are deliberately free of WordPress functions so the
		fixture suites run standalone — they cannot call esc_html() even in
		principle. Nothing surfaces a raw getMessage() to a browser: the Import
		Report maps the stable code_slug() to a translated reason, and escapes every
		cell with esc_html() at render.
	-->
	<rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
		<exclude-pattern>*/includes/ai/*</exclude-pattern>
	</rule>
</ruleset>
